PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-long-random-value

# MongoDB
MONGO_CONNECTION_TEST=mongodb://0.0.0.0:27017/db
MONGO_CONNECTION_PRODUCTION=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# WhatsApp API Configuration
WA_PHONE_NUMBER_ID=
CLOUD_API_ACCESS_TOKEN=
CLOUD_API_VERSION=v22.0
DEFAULT_RECIPIENT_NUMBER=

# Ollama AI Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=orca-mini
